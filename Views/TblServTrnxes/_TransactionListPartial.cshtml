@model IEnumerable<DatabaseAccess.Models.TblServTrnx>

@if (Model.Any())
{
    foreach (var item in Model)
    {
        // --- 1. تحديد الأيقونات بناءً على اسم الخدمة ---
        string pName = item.ServProdFkNavigation?.ServProdName ?? "";

        // أيقونة الاتجاه: سهم فوق أحمر للسحب، سهم تحت أخضر للإيداع
        string dirIcon = pName.Contains("سحب") ? "fa-arrow-up text-danger" : "fa-arrow-down text-success";

        // أيقونة النوع: بنك للمحافظ البنكية، موبايل لشركات الاتصالات
        string typeIcon = "fa-wallet text-secondary"; // افتراضي
        if (pName.Contains("بنك") || pName.Contains("الأهلي") || pName.Contains("مصر")) { typeIcon = "fa-university text-primary"; }
        else if (pName.Contains("كاش") || pName.Contains("فودافون") || pName.Contains("إي أند") || pName.Contains("اتصالات")) { typeIcon = "fa-mobile-alt text-info"; }

        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
            <div class="transaction-card mb-3 d-flex align-items-center p-3 shadow-sm bg-white rounded">

                <!-- أيقونة النوع (بنك/موبايل) -->
                <div class="ms-3 text-center" style="width: 50px;">
                    <i class="fas @typeIcon fa-2x"></i>
                </div>

                <!-- تفاصيل العملية -->
                <div class="flex-grow-1 text-end" dir="rtl">
                    <h6 class="fw-bold mb-1">@pName</h6>
                    <div class="text-muted small">
                        من: @(item.SenderUser?.FullName ?? "-") | إلى: @(item.RecvrUser?.FullName ?? "بيع مباشر")
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">
                        قبل: @item.SendrBlncBfr.ToString("N0") | بعد: @item.SendrBlncAftr.ToString("N0")
                    </div>
                </div>

                <!-- المبلغ وأيقونة السحب/الإيداع -->
                <div class="d-flex align-items-center me-3">
                    <div class="text-start px-3">
                        <div class="fw-bold @(pName.Contains("سحب") ? "text-danger" : "text-success")" style="font-size: 1.2rem;">
                            @item.TotalPriceTrx.ToString("N2")
                        </div>
                        <div class="text-muted small">@item.DateAndTime.ToString("dd MMM, hh:mm tt")</div>
                    </div>
                    <i class="fas @dirIcon fa-2x"></i>
                </div>
            </div>
        </a>
    }
}



