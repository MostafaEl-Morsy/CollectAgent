                @Html.DisplayFor(modelItem => item.TotalPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IndebtAfter)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateAndTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BillingNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ServProdFkNavigation.ServProdCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StatusFkNavigation.StatusName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserIdFkNavigation.ContactNo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
