@model CollectAgent.Models.UserStatsViewModel
@{
    ViewData["Title"] = "المركز المالي للعهدة";
}

<div class="container-fluid p-3">
    <div class="row g-3">

        <!-- العهدة الإجمالية (المركز المالي) - النتيجة النهائية -->
        <div class="col-12 mb-4">
            <div class="card p-4 shadow text-white text-center" style="background-color: #5d3fd3; border-radius: 15px; border: none;">
                <h4 class="mb-1">صافي المركز المالي للوكيل</h4>
                <!-- استخدمنا Math.Abs لعرض الرقم دائماً بشكل نظيف، وفي حالة الخسارة/السالب يمكن تغيير لون المربع برمجياً -->
                <h1 class="fw-bold display-4">@Model.Inventory.ToString("N0")</h1>
                <small class="bg-dark bg-opacity-25 p-2 rounded d-inline-block mt-2">
                    <i class="fas fa-calculator me-1"></i>
                    المعادلة: (رصيد الأجهزة + محافظ الكاش + البنك + ديون على التجار) - (مديونية للشركة + أرصدة مستحقة للتجار)
                </small>
            </div>
        </div>

        <!-- ================= قسم الأصول (أشياء تُجمع) ================= -->
        <div class="col-12 mt-0 mb-1">
            <h5 class="text-secondary border-bottom pb-2"><i class="fas fa-plus-circle text-success me-2"></i> الأصول والحقوق (مبالغ تُجمع)</h5>
        </div>

        <!-- الرصيد (POS) -->
        <div class="col-md-3 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #2ecc71; border-radius: 10px;">
                <p class="mb-1" title="رصيد الأجهزة المتاح للبيع">رصيد الأجهزة (POS)</p>
                <h3 class="fw-bold">@Model.Balance.ToString("N0")</h3>
            </div>
        </div>

        <!-- محافظ الكاش -->
        <div class="col-md-3 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #00cec9; border-radius: 10px;">
                <p class="mb-1">محافظ الكاش</p>
                <h3 class="fw-bold">@Model.Cash.ToString("N0")</h3>
            </div>
        </div>

        <!-- انستا / بنك -->
        <div class="col-md-3 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #0984e3; border-radius: 10px;">
                <p class="mb-1">انستا / المحافظ البنكية</p>
                <h3 class="fw-bold">@Model.Bank.ToString("N0")</h3>
            </div>
        </div>

        <!-- المدينين (أصول) -->
        <div class="col-md-3 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #00b894; border-radius: 10px;">
                <p class="mb-1">أرصدة لدى التجار (آجل)</p>
                <h3 class="fw-bold">@Model.Debtors.ToString("N0")</h3>
            </div>
        </div>

        <!-- ================= قسم الالتزامات (أشياء تُطرح) ================= -->
        <div class="col-12 mt-4 mb-1">
            <h5 class="text-secondary border-bottom pb-2"><i class="fas fa-minus-circle text-danger me-2"></i> الالتزامات والديون (مبالغ تُطرح)</h5>
        </div>

        <!-- النقدية (Indebt) التي كانت بالسالب -->
        <div class="col-md-6 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #d63031; border-radius: 10px;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="mb-1">مديونية للشركة (Indebt)</p>
                        <!-- ملحوظة: تأكد من تطبيق التعديل في الكنترولر لإرسال هذا الرقم كـ موجب، وهو سيُطرح في المعادلة -->
                        <h3 class="fw-bold">@Model.Indebt.ToString("N0")</h3>
                    </div>
                    <span class="badge bg-white text-danger">- يُطرح</span>
                </div>
            </div>
        </div>

        <!-- الدائنين -->
        <div class="col-md-6 col-6">
            <div class="card p-3 shadow-sm text-white h-100" style="background-color: #e17055; border-radius: 10px;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="mb-1">أرصدة مستحقة للتجار (مُقدم)</p>
                        <h3 class="fw-bold">@Model.Creditors.ToString("N0")</h3>
                    </div>
                    <span class="badge bg-white text-danger">- يُطرح</span>
                </div>
            </div>
        </div>

    </div>
</div>

