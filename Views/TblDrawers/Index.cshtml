@model IEnumerable<DatabaseAccess.Models.TblDrawer>

@{
    ViewData["Title"] = "جرد الخزائن";
    // نحتاج تعريف هذا المتغير في الـ View لنستخدمه في الجافاسكريبت
    var hasMorePages = ViewBag.HasMorePages != null && (bool)ViewBag.HasMorePages;
}

<div class="container-fluid">
    <!-- شريط البحث -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0 ps-0"
                               placeholder="بحث باسم المندوب، الكود، أو اسم المحل..."
                               value="@ViewData["CurrentSearch"]">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i> بحث
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- زر إضافة جديد -->
    <div class="mb-3 text-start">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus me-1"></i> إضافة جرد خزينة
        </a>
    </div>

    <!-- حاوية الكروت -->
    <div class="row" id="drawersContainer">
        @if (Model.Any())
        {
            <partial name="_DrawerCardPartial" model="Model" />
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-light">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h5>لا توجد خزائن مطابقة للبحث</h5>
                </div>
            </div>
        }
    </div>

    <!-- مؤشر التحميل -->
    <div id="loadingIndicator" class="text-center py-4" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
        <p class="text-muted mt-2 small">جاري تحميل المزيد من البيانات...</p>
    </div>

    <div id="noMoreData" class="text-center py-3 text-muted" style="display:none;">
        <small>-- تم عرض جميع البيانات --</small>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let page = 2;
            let isLoading = false;
            let hasMore = @(hasMorePages.ToString().ToLower());
            let searchTerm = '@Html.Raw(ViewData["CurrentSearch"])';

            // دالة التحميل
            function loadMoreData() {
                if (isLoading || !hasMore) return;

                isLoading = true;
                $("#loadingIndicator").show();

                $.ajax({
                    url: '@Url.Action("LoadMoreDrawers", "TblDrawers")',
                    type: 'GET',
                    data: {
                        searchTerm: searchTerm,
                        page: page
                    },
                    success: function (data, textStatus, xhr) {
                        if (xhr.status === 204 || $.trim(data) == "") {
                            hasMore = false;
                            $("#loadingIndicator").hide();
                            $("#noMoreData").show();
                        } else {
                            $("#drawersContainer").append(data);
                            page++;
                            $("#loadingIndicator").hide();
                        }
                        isLoading = false;
                    },
                    error: function () {
                        isLoading = false;
                        $("#loadingIndicator").hide();
                        // يمكن إظهار رسالة خطأ هنا
                    }
                });
            }

            // مستمع حدث التمرير
            $(window).scroll(function () {
                // التحقق إذا وصل المستخدم لنهاية الصفحة (مع هامش 100 بيكسل)
                if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                    loadMoreData();
                }
            });
        });
    </script>
}
