@model DatabaseAccess.Models.TblCompany

@{
    ViewData["Title"] = "تعديل بيانات الشركة";
}

<!-- ترويسة الصفحة مع الأزرار -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0 text-dark">
        <i class="fas fa-edit text-warning ms-2"></i> @ViewData["Title"]
    </h3>
    <div>
        <!-- زر عرض التفاصيل (اختياري، لكن مفيد للتنقل) -->
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info shadow-sm">
            <i class="fas fa-eye ms-1"></i> عرض التفاصيل
        </a>
        <a asp-action="Index" class="btn btn-secondary shadow-sm ms-2">
            <i class="fas fa-arrow-left ms-1"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6"> <!-- تحديد حجم العمود لجعل البطاقة متوسطة وأنيقة -->
        <div class="card card-outline card-warning shadow-sm">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-building ms-2"></i> تعديل بيانات الشركة: <span class="text-primary">@Model.Name</span>
                </h3>
            </div>
            <form asp-action="Edit">
                <div class="card-body">
                    <!-- ملخص الأخطاء العامة للموديل -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <input type="hidden" asp-for="Id" />

                    <!-- حقل اسم الشركة -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag ms-1"></i> @Html.DisplayNameFor(model => model.Name)
                        </label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- حقل الشعار (Logo) -->
                    <div class="mb-3">
                        <label asp-for="Logo" class="form-label">
                            <i class="fas fa-image ms-1"></i> @Html.DisplayNameFor(model => model.Logo)
                        </label>
                        <input asp-for="Logo" class="form-control" />
                        <span asp-validation-for="Logo" class="text-danger"></span>
                    </div>

                    <!-- حقل رقم التواصل -->
                    <div class="mb-3">
                        <label asp-for="ContactNo" class="form-label">
                            <i class="fas fa-phone ms-1"></i> @Html.DisplayNameFor(model => model.ContactNo)
                        </label>
                        <input asp-for="ContactNo" class="form-control" dir="ltr" /> <!-- dir="ltr" لضمان ظهور الرقم بشكل صحيح -->
                        <span asp-validation-for="ContactNo" class="text-danger"></span>
                    </div>

                    <!-- حقل حالة التفعيل (IsActive) على شكل مفتاح تبديل -->
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="@Html.IdFor(model => model.IsActive)" asp-for="IsActive">
                        <label class="form-check-label" for="@Html.IdFor(model => model.IsActive)">
                            <i class="fas fa-toggle-on ms-1"></i> @Html.DisplayNameFor(model => model.IsActive)
                        </label>
                        <span asp-validation-for="IsActive" class="text-danger d-block"></span>
                    </div>
                </div>
                <div class="card-footer text-start"> <!-- الأزرار في الأسفل وتكون محاذية لليمين في وضع RTL -->
                    <button type="submit" class="btn btn-success shadow-sm">
                        <i class="fas fa-save ms-1"></i> حفظ التعديلات
                    </button>
                    <a asp-action="Index" class="btn btn-secondary shadow-sm ms-2">
                        <i class="fas fa-times ms-1"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}