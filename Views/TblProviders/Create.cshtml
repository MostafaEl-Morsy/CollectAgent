@model DatabaseAccess.Models.TblProvider

@{
    ViewData["Title"] = "إضافة مزود جديد";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card card-primary card-outline shadow">
                    <div class="card-header">
                        <h3 class="card-title fw-bold"><i class="fas fa-plus-circle me-2"></i> إضافة مزود خدمة جديد</h3>
                    </div>

                    <!-- ✅ لا تنسى enctype -->
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row">
                                <!-- العمود الأول -->
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="ProviderName" class="form-label font-weight-bold">اسم المزود</label>
                                        <input asp-for="ProviderName" class="form-control" placeholder="مثلاً: فوري، فودافون..." />
                                        <span asp-validation-for="ProviderName" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ProvTypeFk" class="form-label font-weight-bold">نوع المزود</label>
                                        <select asp-for="ProvTypeFk" class="form-select" asp-items="ViewBag.ProvTypeFk">
                                            <option value="">-- اختر النوع --</option>
                                        </select>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ProviderCode" class="form-label font-weight-bold">كود النظام</label>
                                        <input asp-for="ProviderCode" class="form-control" placeholder="Fawry100" />
                                    </div>
                                </div>

                                <!-- العمود الثاني -->
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label font-weight-bold">شعار المزود</label>
                                        <input type="file" name="logoFile" class="form-control" id="imgInput" accept="image/*" />

                                        <div class="mt-3 text-center p-2 border rounded bg-light">
                                            <img id="imgPreview" src="/lib/adminlte/assets/img/avatar.png"
                                                 class="img-circle border shadow-sm" style="width: 80px; height: 80px; object-fit: contain; background:white;" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="ProvMainColor" class="form-label font-weight-bold">اللون</label>
                                                <input type="color" id="clrPicker" class="form-control form-control-color w-100" value="#007bff" />
                                                <input asp-for="ProvMainColor" id="clrHex" type="hidden" value="#007bff" />
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-check form-switch mt-4">
                                                <input class="form-check-input" type="checkbox" asp-for="AllowRtrn">
                                                <label class="form-check-label fw-bold" asp-for="AllowRtrn">استرجاع رصيد</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top text-end">
                            <button type="submit" class="btn btn-primary px-5 fw-bold">حفظ البيانات</button>
                            <a asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // معاينة الصورة فور اختيارها
        $("#imgInput").change(function () {
            if (this.files && this.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        // ربط الـ Color Picker
        $("#clrPicker").on("input", function() {
            $("#clrHex").val($(this).val());
        });
    </script>
}