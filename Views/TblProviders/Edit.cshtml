@model DatabaseAccess.Models.TblProvider

@{
    ViewData["Title"] = "تعديل بيانات المزود";
}

<!-- رأس الصفحة -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">تعديل بيانات المزود</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-action="Index">قائمة المزودين</a></li>
                    <li class="breadcrumb-item active">تعديل</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- محتوى النموذج -->
<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <!-- بداية الكارت -->
                <div class="card card-warning card-outline shadow">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-edit me-2"></i> بيانات @Model.ProviderName
                        </h3>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="hidden" asp-for="Id" />

                            <div class="row">
                                <!-- العمود الأيمن: البيانات الأساسية -->
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="ProviderName" class="form-label">اسم المزود</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-building"></i></span>
                                            <input asp-for="ProviderName" class="form-control" placeholder="أدخل اسم الشركة" />
                                        </div>
                                        <span asp-validation-for="ProviderName" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ProvTypeFk" class="form-label">نوع المزود</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-tags"></i></span>
                                            <select asp-for="ProvTypeFk" class="form-select" asp-items="ViewBag.ProvTypeFk"></select>
                                        </div>
                                        <span asp-validation-for="ProvTypeFk" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ProviderCode" class="form-label">كود المزود (System Code)</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                            <input asp-for="ProviderCode" class="form-control" />
                                        </div>
                                        <span asp-validation-for="ProviderCode" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ProviderNo" class="form-label">رقم الخدمة (Service No)</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-headset"></i></span>
                                            <input asp-for="ProviderNo" class="form-control" />
                                        </div>
                                        <span asp-validation-for="ProviderNo" class="text-danger small"></span>
                                    </div>
                                </div>

                                <!-- العمود الأيسر: المظهر والإعدادات -->
                                <div class="col-md-6">
                                    <!-- قسم الشعار مع المعاينة -->
                                    <div class="form-group mb-3">
                                        <label class="form-label">تغيير الشعار (اختياري)</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text"><i class="fas fa-upload"></i></span>
                                            <!-- لاحظ اسم الحقل logoFile يجب أن يطابق اسم الباراميتر في الكونترولر -->
                                            <input type="file" name="logoFile" class="form-control" id="logoUpload" accept="image/*" onchange="previewImage(this)" />
                                        </div>
                                        <!-- حقل مخفي للمسار القديم في حال لم يتم التغيير -->
                                        <input type="hidden" asp-for="ProviderLogo" />

                                        <!-- معاينة الصورة -->
                                        <div class="text-center p-2 border rounded bg-light">
                                            <small class="d-block text-muted mb-2">معاينة</small>
                                            @{
                                                var imgDisplay = string.IsNullOrEmpty(Model.ProviderLogo)
                                                ? "/lib/adminlte/assets/img/avatar.png"
                                                : "/" + Model.ProviderLogo.Replace("~", "").TrimStart('/');
                                            }
                                            <img id="logoPreview" src="@Url.Content(imgDisplay)"
                                                 class="img-circle elevation-2"
                                                 style="width: 100px; height: 100px; object-fit: contain; background: white;" />
                                        </div>
                                    </div>

                                    <!-- قسم اختيار اللون -->
                                    <div class="form-group mb-3">
                                        <label asp-for="ProvMainColor" class="form-label">اللون المميز</label>
                                        <div class="input-group">
                                            <input type="color" class="form-control form-control-color" id="colorPicker" value="@Model.ProvMainColor" title="اختر اللون">
                                            <input asp-for="ProvMainColor" type="text" class="form-control" id="colorText" placeholder="#RRGGBB" />
                                        </div>
                                        <span asp-validation-for="ProvMainColor" class="text-danger small"></span>
                                    </div>

                                    <hr />

                                    <!-- مفاتيح التفعيل -->
                                    <div class="d-flex justify-content-around mt-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="IsActive" style="cursor: pointer; transform: scale(1.3);">
                                            <label class="form-check-label fw-bold me-3" asp-for="IsActive">تفعيل المزود</label>
                                        </div>

                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="AllowRtrn" style="cursor: pointer; transform: scale(1.3);">
                                            <label class="form-check-label fw-bold me-3" asp-for="AllowRtrn">استرجاع الرصيد</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ذيل الكارت: الأزرار -->
                        <div class="card-footer bg-white border-top">
                            <button type="submit" class="btn btn-warning px-4 fw-bold">
                                <i class="fas fa-save me-1"></i> حفظ التعديلات
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-times me-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
                <!-- نهاية الكارت -->
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // 1. كود ربط مختار الألوان بحقل النص
        const colorPicker = document.getElementById('colorPicker');
        const colorText = document.getElementById('colorText');

        // عند تغيير اللون من الدائرة، نغير النص
        colorPicker.addEventListener('input', (event) => {
            colorText.value = event.target.value;
        });

        // عند كتابة كود اللون يدوياً، نغير الدائرة
        colorText.addEventListener('input', (event) => {
            colorPicker.value = event.target.value;
        });

        // 2. تحديث معاينة الصورة عند تغيير المسار يدوياً
        function updatePreview() {
            var inputVal = document.getElementById('logoInput').value;
            // معالجة بسيطة للمسار كما في السيرفر
            var cleanPath = inputVal.replace('~', '').replace('//', '/');
            if(!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;

            document.getElementById('logoPreview').src = cleanPath;
        }
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('logoPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}