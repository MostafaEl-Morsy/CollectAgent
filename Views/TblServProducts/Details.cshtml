@model DatabaseAccess.Models.TblServProduct

@{
    ViewData["Title"] = "تفاصيل المنتج";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <!-- الكارت الرئيسي -->
            <div class="card card-primary card-outline shadow-lg border-top-3">

                <!-- رأس الكارت -->
                <div class="card-header bg-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title m-0 fw-bold text-primary">
                            <i class="fas fa-box-open me-2"></i> تفاصيل المنتج
                        </h3>
                        <div class="card-tools">
                            <span class="badge @(Model.IsActive == true ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                @(Model.IsActive == true ? "نشط" : "معطل")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body">

                    <!-- 1. عنوان المنتج والكود -->
                    <div class="text-center mb-5">
                        <div class="avatar-circle mb-3 mx-auto bg-light text-primary d-flex justify-content-center align-items-center" style="width: 80px; height: 80px; border-radius: 50%; font-size: 2rem;">
                            <i class="fas fa-cube"></i>
                        </div>
                        <h2 class="fw-bold text-dark">@Html.DisplayFor(model => model.ServProdName)</h2>
                        <span class="text-muted fs-5">Code: <span class="font-monospace text-dark bg-light px-2 rounded border">@Html.DisplayFor(model => model.ServProdCode)</span></span>
                    </div>

                    <div class="row">
                        <!-- 2. بيانات التصنيف والارتباط (العمود الأيمن) -->
                        <div class="col-md-6">
                            <div class="card shadow-none border h-100">
                                <div class="card-header bg-light fw-bold">
                                    <i class="fas fa-sitemap me-1 text-secondary"></i> التصنيف والتبعية
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-striped mb-0">
                                        <tbody>
                                            <tr>
                                                <th style="width: 40%" class="ps-4">مزود الخدمة</th>
                                                <td>@Html.DisplayFor(model => model.ServProvFkNavigation.ProviderCode)</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-4">فئة المنتج</th>
                                                <td>@Html.DisplayFor(model => model.CategoryFkNavigation.ProdCatName)</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-4">نوع المنتج</th>
                                                <td>@Html.DisplayFor(model => model.TypeFkNavigation.ProdTypeName)</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-4">المستخدم / التاجر</th>
                                                <td>
                                                    <i class="fas fa-user-tag text-muted fa-xs"></i>
                                                    @Html.DisplayFor(model => model.UserIdFkNavigation.ContactNo)
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- 3. البيانات المالية (العمود الأيسر) -->
                        <div class="col-md-6 mt-4 mt-md-0">
                            <div class="card shadow-none border h-100">
                                <div class="card-header bg-light fw-bold">
                                    <i class="fas fa-money-bill-wave me-1 text-success"></i> البيانات المالية
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <!-- سعر البيع -->
                                        <div class="col-6">
                                            <div class="p-3 border rounded text-center bg-success-subtle">
                                                <small class="text-muted d-block">سعر البيع</small>
                                                <span class="fs-4 fw-bold text-success">@Model.ServProdSellPrice</span>
                                            </div>
                                        </div>
                                        <!-- سعر الشراء -->
                                        <div class="col-6">
                                            <div class="p-3 border rounded text-center bg-danger-subtle">
                                                <small class="text-muted d-block">سعر الشراء</small>
                                                <span class="fs-4 fw-bold text-danger">@Model.ServProdBuyPrice</span>
                                            </div>
                                        </div>
                                        <!-- الرصيد -->
                                        <div class="col-12">
                                            <div class="p-3 border rounded d-flex justify-content-between align-items-center bg-light">
                                                <span class="fw-bold text-muted">الرصيد الحالي</span>
                                                <span class="fs-5 fw-bold text-dark">@Html.DisplayFor(model => model.ServProdBalance) جنيه</span>
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="my-3" />

                                    <div class="row small text-muted">
                                        <div class="col-4 text-center border-end">
                                            <div>الرسوم</div>
                                            <div class="text-dark fw-bold">@Model.ServProdFees</div>
                                        </div>
                                        <div class="col-4 text-center border-end">
                                            <div>عمولة بيع</div>
                                            <div class="text-dark fw-bold">@Model.ServProdSellComm</div>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div>عمولة شراء</div>
                                            <div class="text-dark fw-bold">@Model.ServProdBuyComm</div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- التذييل والأزرار -->
                <div class="card-footer bg-white p-3 border-top">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-right"></i> عودة للقائمة
                        </a>

                        <div>
                            @* زر الحذف يمكن إضافته هنا اختيارياً *@
                            @* <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-outline-danger me-2">حذف</a> *@

                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">
                                <i class="fas fa-pen"></i> تعديل البيانات
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>