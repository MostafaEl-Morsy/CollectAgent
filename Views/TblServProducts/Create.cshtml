@model DatabaseAccess.Models.TblServProduct

@{
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card card-primary card-outline shadow-sm">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-plus-circle text-primary me-2"></i>
                        بيانات المنتج الجديد
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-tool" title="عودة للقائمة">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>

                <form asp-action="Create">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- القسم الأول: البيانات الأساسية -->
                        <h5 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-info-circle"></i> البيانات الأساسية</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdName" class="form-label fw-bold">اسم الخدمة/المنتج</label>
                                <input asp-for="ServProdName" class="form-control" placeholder="أدخل اسم المنتج" />
                                <span asp-validation-for="ServProdName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdCode" class="form-label fw-bold">كود المنتج</label>
                                <input asp-for="ServProdCode" class="form-control" placeholder="Code" />
                                <span asp-validation-for="ServProdCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- القسم الثاني: التصنيف والتبعية -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-3"><i class="fas fa-sitemap"></i> التصنيف والتبعية</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ServProvFk" class="form-label">مزود الخدمة</label>
                                <select asp-for="ServProvFk" class="form-control select2" asp-items="ViewBag.ServProvFk">
                                    <option value="">-- اختر المزود --</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryFk" class="form-label">فئة المنتج</label>
                                <select asp-for="CategoryFk" class="form-control select2" asp-items="ViewBag.CategoryFk">
                                    <option value="">-- اختر الفئة --</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TypeFk" class="form-label">نوع المنتج</label>
                                <select asp-for="TypeFk" class="form-control select2" asp-items="ViewBag.TypeFk">
                                    <option value="">-- اختر النوع --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserIdFk" class="form-label">التاجر / المستخدم</label>
                                <select asp-for="UserIdFk" class="form-control select2" asp-items="ViewBag.UserIdFk">
                                    <option value="">-- اختر المستخدم --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch ps-0">
                                    <label class="form-check-label ms-5 fw-bold" for="IsActive">حالة التفعيل</label>
                                    <input class="form-check-input ms-0 float-end" style="width: 3em; margin-left: -3.5em;" type="checkbox" asp-for="IsActive" id="IsActive" checked>
                                </div>
                            </div>
                        </div>

                        <!-- القسم الثالث: البيانات المالية (اختياري - أضفتها لأنها موجودة في المودل) -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-3"><i class="fas fa-coins"></i> البيانات المالية</h5>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdBuyPrice" class="form-label small">سعر الشراء</label>
                                <input asp-for="ServProdBuyPrice" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdSellPrice" class="form-label small">سعر البيع</label>
                                <input asp-for="ServProdSellPrice" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdFees" class="form-label small">الرسوم</label>
                                <input asp-for="ServProdFees" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdBalance" class="form-label small">الرصيد الافتتاحي</label>
                                <input asp-for="ServProdBalance" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdBuyComm" class="form-label small">عمولة الشراء</label>
                                <input asp-for="ServProdBuyComm" class="form-control" type="number" step="0.001" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdSellComm" class="form-label small">عمولة البيع</label>
                                <input asp-for="ServProdSellComm" class="form-control" type="number" step="0.001" />
                            </div>
                        </div>

                    </div>

                    <div class="card-footer bg-white text-end">
                        <a asp-action="Index" class="btn btn-secondary me-2">إلغاء</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save"></i> حفظ البيانات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // تفعيل مكتبة Select2 لجميع القوائم المنسدلة
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                dir: "rtl",
                language: "ar"
            });
        });
    </script>
}