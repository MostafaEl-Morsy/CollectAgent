@model DatabaseAccess.Models.TblServProduct

@{
    ViewData["Title"] = "تعديل المنتج";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- الكارد الرئيسي بتصميم AdminLTE -->
            <div class="card card-info card-outline shadow-sm">
                <div class="card-header">
                    <h3 class="card-title text-info fw-bold">
                        <i class="fas fa-edit me-2"></i>
                        تعديل بيانات المنتج: <span class="text-dark">@Model.ServProdName</span>
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-tool" title="عودة للقائمة">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>

                <form asp-action="Edit">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- الحقل الخفي للمعرف (ID) ضروري جداً في التعديل -->
                        <input type="hidden" asp-for="Id" />

                        <!-- القسم الأول: البيانات الأساسية -->
                        <h5 class="text-info border-bottom pb-2 mb-3"><i class="fas fa-info-circle"></i> البيانات الأساسية</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdName" class="form-label fw-bold small text-muted">اسم الخدمة/المنتج</label>
                                <input asp-for="ServProdName" class="form-control" placeholder="أدخل اسم المنتج" />
                                <span asp-validation-for="ServProdName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdCode" class="form-label fw-bold small text-muted">كود المنتج</label>
                                <input asp-for="ServProdCode" class="form-control" placeholder="Code" />
                                <span asp-validation-for="ServProdCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- القسم الثاني: التصنيف والتبعية -->
                        <h5 class="text-info border-bottom pb-2 mb-3 mt-3"><i class="fas fa-sitemap"></i> التصنيف والتبعية</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ServProvFk" class="form-label small text-muted">مزود الخدمة</label>
                                <select asp-for="ServProvFk" class="form-control select2" asp-items="ViewBag.ServProvFk"></select>
                                <span asp-validation-for="ServProvFk" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryFk" class="form-label small text-muted">فئة المنتج</label>
                                <select asp-for="CategoryFk" class="form-control select2" asp-items="ViewBag.CategoryFk"></select>
                                <span asp-validation-for="CategoryFk" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TypeFk" class="form-label small text-muted">نوع المنتج</label>
                                <select asp-for="TypeFk" class="form-control select2" asp-items="ViewBag.TypeFk"></select>
                                <span asp-validation-for="TypeFk" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserIdFk" class="form-label small text-muted">التاجر / المستخدم</label>
                                <select asp-for="UserIdFk" class="form-control select2" asp-items="ViewBag.UserIdFk"></select>
                                <span asp-validation-for="UserIdFk" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch ps-0">
                                    <label class="form-check-label ms-5 fw-bold" for="IsActive">حالة التفعيل</label>
                                    <input class="form-check-input ms-0 float-end" style="width: 3em; margin-left: -3.5em;" type="checkbox" asp-for="IsActive" id="IsActive">
                                </div>
                            </div>
                        </div>

                        <!-- القسم الثالث: البيانات المالية -->
                        <h5 class="text-info border-bottom pb-2 mb-3 mt-3"><i class="fas fa-coins"></i> البيانات المالية</h5>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdBuyPrice" class="form-label small text-muted">سعر الشراء</label>
                                <div class="input-group">
                                    <input asp-for="ServProdBuyPrice" class="form-control text-center fw-bold" type="number" step="0.01" />
                                    <span class="input-group-text">£</span>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdSellPrice" class="form-label small text-muted">سعر البيع</label>
                                <div class="input-group">
                                    <input asp-for="ServProdSellPrice" class="form-control text-center fw-bold text-success" type="number" step="0.01" />
                                    <span class="input-group-text">£</span>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdFees" class="form-label small text-muted">الرسوم</label>
                                <input asp-for="ServProdFees" class="form-control text-center" type="number" step="0.01" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="ServProdBalance" class="form-label small text-muted">الرصيد الحالي</label>
                                <input asp-for="ServProdBalance" class="form-control text-center bg-light" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdBuyComm" class="form-label small text-muted">عمولة الشراء</label>
                                <input asp-for="ServProdBuyComm" class="form-control" type="number" step="0.001" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServProdSellComm" class="form-label small text-muted">عمولة البيع</label>
                                <input asp-for="ServProdSellComm" class="form-control" type="number" step="0.001" />
                            </div>
                        </div>

                    </div>

                    <div class="card-footer bg-white text-end py-3">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">
                            <i class="fas fa-undo"></i> تراجع
                        </a>
                        <button type="submit" class="btn btn-info px-5 text-white">
                            <i class="fas fa-check-circle"></i> حفظ التغييرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // تفعيل مكتبة Select2
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                dir: "rtl",
                language: "ar"
            });
        });
    </script>
}