@model CollectAgent.Models.UserStatsViewModel

<!-- رصيد الأجهزة (POS) -->
<div class="col-6 col-lg">
    <a asp-controller="TblRegistrations" asp-action="RegBalance" style="text-decoration:none; color:inherit;">
        <div class="info-box mb-3 shadow-sm">
            <span class="info-box-icon bg-custom-teal elevation-1">
                <i class="fas fa-money-bill-wave"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text">رصيد الأجهزة</span>
                <span class="info-box-number text-success">@Model.Balance.ToString("N2")</span>
            </div>
        </div>
    </a>
</div>

<!-- صافي رصيد الوكيل (العهدة) -->
<div class="col-6 col-lg">
    <a asp-controller="Home" asp-action="InventoryDetails" style="text-decoration:none; color:inherit;">
        <div class="info-box mb-3 shadow-sm">
            <span class="info-box-icon bg-custom-purple elevation-1">
                <i class="fas fa-box"></i>
            </span>
            <div class="info-box-content">
                <span class="info-box-text">صافي رصيد الوكيل</span>
                @if (Model.Inventory >= 0)
                {
                    <span class="info-box-number text-success">@Model.Inventory.ToString("N2")</span>
                }
                else
                {
                    <span class="info-box-number text-danger">@Model.Inventory.ToString("N2")</span>
                }
            </div>
        </div>
    </a>
</div>

<!-- المحافظ البنكية -->
<div class="col-6 col-lg">
    <div class="info-box mb-3 shadow-sm">
        <span class="info-box-icon bg-custom-yellow elevation-1">
            <i class="fas fa-university text-dark"></i>
        </span>
        <div class="info-box-content">
            <span class="info-box-text">المحافظ البنكية</span>
            <span class="info-box-number">@Model.Bank.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- محافظ الكاش -->
<div class="col-6 col-lg">
    <div class="info-box mb-3 shadow-sm">
        <span class="info-box-icon bg-custom-red elevation-1">
            <i class="fas fa-cash-register"></i>
        </span>
        <div class="info-box-content">
            <span class="info-box-text">محافظ الكاش</span>
            <span class="info-box-number">@Model.Cash.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- مديونية الشركة -->
<div class="col-6 col-lg">
    <div class="info-box mb-3 shadow-sm">
        <span class="info-box-icon elevation-1" style="background-color: #e74c3c;">
            <i class="fas fa-hand-holding-usd text-white"></i>
        </span>
        <div class="info-box-content">
            <span class="info-box-text">مديونية للشركة</span>
            @if (Model.Indebt > 0)
            {
                <span class="info-box-number text-danger fw-bold">@Model.Indebt.ToString("N2")</span>
            }
            else
            {
                <span class="info-box-number text-success">0.00</span>
            }
        </div>
    </div>
</div>