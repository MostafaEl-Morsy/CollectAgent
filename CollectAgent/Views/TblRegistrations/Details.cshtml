@model DatabaseAccess.Models.TblRegistration

@{
    ViewData["Title"] = "تفاصيل حساب POS";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-info-circle me-2"></i>
            @ViewData["Title"]: @Model.AccNameNo
        </h3>
        <div class="card-tools">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> العودة للقائمة
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- العمود الأول: بيانات الحساب الأساسية -->
            <div class="col-md-6">
                <h5><i class="fas fa-file-invoice-dollar text-primary"></i> بيانات الحساب</h5>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">اسم/رقم الحساب</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.AccNameNo)</dd>

                    <dt class="col-sm-4">الكود</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Code)</dd>

                    <dt class="col-sm-4">الرصيد</dt>
                    <!-- ✅ التصحيح: بما أن الرصيد int، ننسقه مباشرة -->
                    <dd class="col-sm-8 fw-bold">@Model.Balance.ToString("N2")</dd>

                    <dt class="col-sm-4">تاريخ البدء</dt>
                    <!-- ✅ التصحيح: بما أن التاريخ DateTime، ننسقه مباشرة -->
                    <dd class="col-sm-8">@Model.StartDate.Value.ToString("yyyy/MM/dd")</dd>

                    <dt class="col-sm-4">الحالة</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">غير فعال</span>
                        }
                    </dd>
                </dl>
            </div>

            <!-- العمود الثاني: بيانات التاجر والمزود -->
            <div class="col-md-6">
                <h5><i class="fas fa-user-tag text-info"></i> بيانات التاجر والمزود</h5>
                <hr />
                <dl class="row">
                    @if (Model.UserFkNavigation != null)
                    {
                        <dt class="col-sm-4">التاجر</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.UserFkNavigation.FullName)</dd>

                        <dt class="col-sm-4">رقم الاتصال</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.UserFkNavigation.ContactNo)</dd>
                    }

                    @if (Model.ProviderFkNavigation != null)
                    {
                        <dt class="col-sm-4">مزود الخدمة</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.ProviderFkNavigation.ProviderName)</dd>

                        <dt class="col-sm-4">كود المزود</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.ProviderFkNavigation.ProviderCode)</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>