@model CollectAgent.Models.CollectTransferAction

@{
    ViewData["Title"] = "تحصيل نقـدي ورصـيد";
    // سيتم استخدام ملف الـ Layout الافتراضي تلقائياً
}

@section Styles {
    <!-- رابط لملف التنسيق المخصص لهذه الصفحة فقط -->
    <link rel="stylesheet" href="~/css/collection-style.css" asp-append-version="true" />
}


<div class="collection-page-container">
    <!-- حاوية جديدة لتوسيط المحتوى -->
    @using (Html.BeginForm("Create", "Coll", FormMethod.Post, new { id = "collectionForm", @class = "collection-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.CollectFromID)
        @Html.HiddenFor(model => model.TransactionTimestamp)

        <main class="form-content">
            <!-- Shop Name and Current Debt -->
            <div class="debt-card">
                <label class="debt-label">@ViewBag.ShopName - مديونية التاجر الحالية</label>
                <div class="debt-value">
                    @Html.EditorFor(model => model.CollectFromDebtBfor, new { htmlAttributes = new { @class = "debt-input", @id = "receiverDebt", @readonly = "readonly" } })
                    <span>ج.م</span>
                </div>
            </div>

            <!-- Cash Denominations Section -->
            <div class="denominations-card">
                <h5 class="section-title">فئات النقدية</h5>
                <div id="denominations-container">
                    <!-- Items are generated dynamically by JavaScript -->
                </div>
            </div>

            <!-- Summary and Actions Section -->
            <div class="summary-card">
                <!-- Total Cash -->
                <div class="summary-row">
                    <label>إجمالي النقدية</label>
                    <span class="summary-value total" id="total-cash-display">0 ج.م</span>
                    @Html.HiddenFor(model => model.TotlMoneyTranact, new { @id = "Total" })
                </div>

                <!-- Return Balance Checkbox and Input -->
                <div class="return-balance-toggle">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="CkbRtrnBlnc">
                        <label class="form-check-label" for="CkbRtrnBlnc">إرجـاع رصيـد؟</label>
                    </div>
                </div>
                <div id="return-balance-section" style="display: none;">
                    <div class="mb-3">
                        @* القائمة المنسدلة الجديدة *@
                        @Html.DropDownListFor(model => model.SupplierRegistrationId, ViewBag.SupplierAccounts as SelectList, "--- اختر حساب المورد ---", new { @class = "form-select" })
                    </div>
                    <div>
                        @Html.EditorFor(model => model.BlncReturned, new { htmlAttributes = new { @class = "form-control balance-input", @id = "BlncReturned", @placeholder = "قيمة الرصيد المرتجع", @Value = "0", @type = "number", min = "0" } })
                    </div>
                </div>
                @* <div id="return-balance-section" style="display: none;">
                    @Html.EditorFor(model => model.BlncReturned, new { htmlAttributes = new { @class = "form-control balance-input", @id = "BlncReturned", @placeholder = "قيمة الرصيد المرتجع", @Value = "0", @type = "number", min = "0" } })
                </div> *@

                <!-- Final Debt -->
                <div class="summary-row final-debt">
                    <label>المديونية بعد التحصيل</label>
                    <span class="summary-value remaining" id="remaining-amount-display">0 ج.م</span>
                    @Html.HiddenFor(model => model.CollectFromDebtAftr, new { @id = "remainingamount" })
                </div>
            </div>

            <!-- Submit and Back Buttons -->
            <div class="action-buttons">
                <button type="submit" class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#loading">
                    <i class="fa-solid fa-cash-register"></i> تأكيد التحصيل
                </button>
                <a href="@Url.Action("IndexToOprate", "TblUsers")" class="btn btn-back">
                    <i class="fa-solid fa-arrow-left"></i> العودة للقائمة
                </a>
            </div>
        </main>
    }
</div>


<!-- Loading Modal -->
<div class="modal fade" id="loading" tabindex="-1" aria-labelledby="loadingModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered border-0">
        <div class="modal-content" style="background-color: transparent; border: none;">
            <div class="modal-body text-center">
                <div class="spinner-border text-light" style="width: 5rem; height: 5rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-white h4 mt-3"> جــاري الـتـنـفـيـــذ ... </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        // --- نفس كود الجافاسكريبت من الإجابة السابقة ---
        $(document).ready(function () {
            const denominations = [
                { value: 200, modelProp: 'Le200' },
                { value: 100, modelProp: 'Le100' },
                { value: 50,  modelProp: 'Le50' },
                { value: 20,  modelProp: 'Le20' },
                { value: 10,  modelProp: 'Le10' },
                { value: 5,   modelProp: 'Le5' }
            ];

            const formatCurrency = (num) => `${(num || 0).toLocaleString()} ج.م`;

            function calculateTotals() {
                let totalCash = 0;
                $('.denomination-item').each(function () {
                    const item = $(this);
                    const value = parseFloat(item.data('value'));
                    const count = parseFloat(item.find('.denomination-input').val()) || 0;
                    const subTotal = count * value;
                    item.find('.total-value').text(subTotal.toLocaleString());
                    totalCash += subTotal;
                });

                $('#total-cash-display').text(formatCurrency(totalCash));
                $('#Total').val(totalCash);

                const initialDebt = parseFloat($('#receiverDebt').val()) || 0;
                const returnedBalance = parseFloat($('#BlncReturned').val()) || 0;
                const remainingDebt = initialDebt - totalCash - returnedBalance;

                const $remainingDisplay = $('#remaining-amount-display');
                $remainingDisplay.text(formatCurrency(remainingDebt));

                var isFieldDisabled = @((ViewBag.IsAmountFieldDisabled ?? false).ToString().ToLower());
                if (isFieldDisabled) {
                    $('#remainingamount').val(remainingDebt);
                }
            }

            const container = $('#denominations-container');
            denominations.forEach(d => {
                const itemHtml = `
                    <div class="denomination-item" data-value="${d.value}">
                        <div class="denomination-label">${d.value} ج.م</div>
                        <div class="denomination-controls">
                            <button type="button" class="btn-stepper plus-btn" aria-label="Increase count">+</button>
                            <input class="denomination-input" type="number" min="0" value="0"
                                   id="${d.modelProp}" name="${d.modelProp}">
                            <button type="button" class="btn-stepper minus-btn" aria-label="Decrease count">-</button>
                        </div>
                        <div class="denomination-total">
                            <span class="total-value">0</span>
                            <span class="currency">ج.م</span>
                        </div>
                    </div>`;
                container.append(itemHtml);
            });

            container.on('click', '.btn-stepper', function () {
                const $input = $(this).siblings('.denomination-input');
                let currentValue = parseInt($input.val(), 10) || 0;
                if ($(this).hasClass('plus-btn')) {
                    currentValue++;
                } else if (currentValue > 0) {
                    currentValue--;
                }
                $input.val(currentValue).trigger('input');
            });

            $(document).on('input', '.denomination-input, #BlncReturned', function () {
                if (parseFloat(this.value) < 0 || this.value === '') {
                    if (this.value !== '') this.value = 0;
                }
                calculateTotals();
            });

            $('#BlncReturned').on('focus', function () {
                if ($(this).val() === '0') $(this).val('');
            }).on('blur', function () {
                if ($(this).val() === '') $(this).val('0');
            });

            // إخفاء الصفر عند الضغط على خانة الفئات
            $(document).on('focus', '.denomination-input', function () {
                if ($(this).val() === '0') $(this).val('');
            });

            $(document).on('blur', '.denomination-input', function () {
                if ($(this).val() === '') $(this).val('0');
                calculateTotals();
            });

                    $("#CkbRtrnBlnc").change(function () {
            const isChecked = $(this).is(":checked");
            const $section = $("#return-balance-section");

            if (isChecked) {
                $section.slideDown(200);

                // --== [بداية إضافة الاختيار التلقائي] ==--
                var $supplierSelect = $('#SupplierRegistrationId');
                // إذا كان هناك خياران فقط (1: "--- اختر ---"، 2: حساب المورد الفعلي)
                if ($supplierSelect.find('option').length === 2) {
                    // قم باختيار الحساب الفعلي تلقائياً (الاندكس 1)
                    $supplierSelect.prop('selectedIndex', 1);
                }
                // --== [نهاية الإضافة] ==--

                $('#BlncReturned').focus().select();
            } else {
                $section.slideUp(200, function() {
                    $('#BlncReturned').val(0).trigger('input');

                    // إعادة القائمة المنسدلة إلى وضعها الافتراضي عند إغلاق الزر
                    $('#SupplierRegistrationId').prop('selectedIndex', 0);
                });
            }
        });

            $('#collectionForm').submit(function() {
                var now = new Date();
                var local = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
                    .toISOString().slice(0, 19);
                $('#TransactionTimestamp').val(local);
            });
            // Initial calculation on page load

            calculateTotals();
        });
    </script>
}