@model IEnumerable<DatabaseAccess.Models.TblProvider>

@foreach (var item in Model)
{
    <!-- استخدام col-xl-4 لعرض 3 كروت في الشاشات الكبيرة -->
    <div class="col-12 col-md-6 col-xl-4 mb-3 provider-card-item fade-in">
        <div class="card card-outline card-primary shadow-sm h-100 border-top-3">

            <!-- الهيدر: تم تعديله ليكون مرناً -->
            <div class="card-header bg-white border-0 pt-3">
                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div class="flex-grow-1 overflow-hidden">
                        <h5 class="fw-bold mb-1 text-dark text-truncate">@item.ProviderName</h5>
                        <p class="text-muted small mb-1">
                            <i class="fas fa-tag me-1"></i> @(item.ProvTypeFkNavigation?.ProvTypeName ?? "عام")
                        </p>
                        <span class="badge bg-light text-dark border">@item.ProviderCode</span>
                    </div>

                    <!-- مكان الصورة: تم إصلاح المسار -->
                    <div class="flex-shrink-0">
                        @{
                            // كود إصلاح مسار الصورة
                            var imgPath = item.ProviderLogo;
                            if (!string.IsNullOrEmpty(imgPath))
                            {
                                // نحذف علامة ~ ونضمن وجود / في البداية
                                imgPath = "/" + imgPath.Replace("~", "").TrimStart('/');
                            }
                        }

                        @if (!string.IsNullOrEmpty(imgPath))
                        {
                            <img src="@Url.Content(imgPath)"
                                 onerror="this.onerror=null; this.src='/lib/adminlte/assets/img/avatar.png';"
                                 class="rounded-circle shadow-sm border p-1"
                                 style="width: 55px; height: 55px; object-fit: contain; background: #fff;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary border"
                                 style="width: 55px; height: 55px;">
                                <i class="fas fa-building fa-lg"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <hr class="my-0 mx-3 text-muted opacity-25">

            <div class="card-body py-2 px-3">
                <div class="row g-2 align-items-center text-sm">
                    <div class="col-6">
                        <span class="text-muted d-block small">الحالة</span>
                        @if (item.IsActive == true)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">معطل</span>
                        }
                    </div>
                    @* <div class="col-6"> *@
                        @* <span class="text-muted d-block small">اللون</span> *@
                        @* <div class="d-flex align-items-center gap-2"> *@
                            @* <div style="width: 15px; height: 15px; background-color: @(item.ProvMainColor ?? "#eee"); border-radius: 50%; border: 1px solid #ddd;"></div> *@
                            @* <span class="small text-muted" dir="ltr">@(item.ProvMainColor ?? "--")</span> *@
                        @* </div> *@
                    @* </div> *@
                </div>
            </div>

            <div class="card-footer bg-light border-top-0 p-2">
                <div class="btn-group w-100 shadow-sm" role="group">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border text-primary">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border text-info">
                        <i class="fas fa-info-circle"></i> تفاصيل
                    </a>
                    @* <button type="button" class="btn btn-sm btn-white border text-danger" onclick="confirmDelete(@item.Id)">
                        <i class="fas fa-trash-alt"></i>
                    </button> *@
                </div>
            </div>
        </div>
    </div>
}