@using X.PagedList
@model IPagedList<DatabaseAccess.Models.TblDebtTrnsAct>

@{
    var currentAccountId = ViewBag.CurrentAccountId as int? ?? 0;
}

@if (Model == null || !Model.Any())
{
    @if (Model?.PageNumber == 1 || Model == null)
    {
        <div class="text-center py-5">
            <i class="fas fa-file-invoice-dollar fa-4x text-muted opacity-25 mb-3"></i>
            <h5 class="text-muted">لا توجد حركات مالية لعرضها</h5>
        </div>
    }
}
else
{
    foreach (var item in Model)
    {
        // ==========================================
        // 1. قراءة البيانات المباشرة من قاعدة البيانات (بدون تخمين)
        // ==========================================
        int transTypeId = item.TransTypeId;
        string transTypeName = item.TransType?.TransTypeName ?? "عملية غير محددة";

        // استخراج المبالغ المطلقة (تجريدها من السوالب)
        decimal cashAmount = Math.Abs(item.AmntTrnsAct);
        decimal balanceAmount = Math.Abs(item.BlncTrnsAct ?? 0);

        // ==========================================
        // 2. تحديد الاتجاه (وارد أم صادر) بناءً على رقم نوع العملية في الداتا بيز
        // ==========================================
        bool isIncoming = false;

        // الأنواع الواردة للوكيل: 2 (تحصيل)، 5 (استلام)
        if (transTypeId == 2 || transTypeId == 5)
        {
            isIncoming = true;
        }
        // الأنواع الصادرة من الوكيل: 1 (شحن)، 3 (توريد)، 4 (إيداع)، 6 (سحب)
        else
        {
            isIncoming = false;
        }

        // ==========================================
        // 3. تحديد الأطراف والأرصدة بناءً على اتجاه العملية
        // ==========================================
        bool isAccidToMe = item.AccidColToFk == currentAccountId;

        // من هو الطرف الآخر؟
        var otherPartyNav = isAccidToMe ? item.AccidColFromFkNavigation : item.AccidColToFkNavigation;
        string otherParty = otherPartyNav?.UserIdFkNavigation?.UserCode ?? otherPartyNav?.UserIdFkNavigation?.FullName ?? "غير معروف";
        string providerName = item.ProvidFkNavigation?.ProviderName ?? "مورد عام";

        // المديونية
        long debtBefore = (isAccidToMe ? item.ColFrmDbtBefr : item.ColToDbtBfr) ?? 0;
        long debtAfter = (isAccidToMe ? item.ColfrmDebtAfter : item.ColToDbtAftr) ?? 0;

        // ==========================================
        // 4. تجهيز النصوص والألوان للتصميم
        // ==========================================
        string badgeDirection = isIncoming ? "وارد" : "صادر";
        string badgeText = $"{badgeDirection} ({transTypeName})";
        string icon = isIncoming ? "fa-arrow-down" : "fa-arrow-up";
        string sign = isIncoming ? "+" : "-";

        string badgeClass, textClass;

        if (isIncoming)
        {
            // === وارد (أخضر دائماً) ===
            badgeClass = "bg-success";
            textClass = "text-success";
        }
        else
        {
            // === صادر ===
            // إذا كان الصادر رصيد (شحن) نلونه أزرق، وإذا كان نقدية (إيداع/سداد) نلونه أحمر
            if (balanceAmount > 0 && cashAmount == 0)
            {
                badgeClass = "bg-primary";
                textClass = "text-primary";
            }
            else
            {
                badgeClass = "bg-danger";
                textClass = "text-danger";
            }
        }

        // ==========================================
        // 5. التصميم (HTML)
        // ==========================================
        <div class="card mb-3 shadow-sm border-0" style="border-right: 4px solid @(textClass == "text-success" ? "#28a745" : (textClass == "text-primary" ? "#0d6efd" : "#dc3545")); border-radius: 10px;">

            <!-- الشريط العلوي -->
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge @badgeClass bg-opacity-10 @textClass border border-0 px-2 py-1">
                        <i class="fas @icon me-1"></i> @badgeText
                    </span>
                    <span class="text-muted small ms-2" dir="ltr">#@item.ReferenceCode</span>
                </div>
                <div class="text-muted small" dir="ltr">
                    <i class="far fa-clock me-1"></i> @item.DateAndTime.ToString("yyyy/MM/dd hh:mm tt")
                </div>
            </div>

            <!-- جسم الكارت -->
            <div class="card-body pt-2 pb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <!-- التفاصيل (يمين) -->
                    <div class="pe-2" style="max-width: 60%;">
                        <small class="text-muted d-block mb-1">وصف نوع العملية</small>

                        <h5 class="fw-bold text-dark mb-1 text-truncate" title="@otherParty">
                            @(isIncoming ? "من:" : "إلى:") @otherParty
                        </h5>

                        <span class="badge bg-light text-dark border mt-1 px-2 py-1">
                            <i class="fas fa-building text-secondary me-1"></i> @providerName
                        </span>
                    </div>

                    <!-- المبلغ (يسار) - يعرض القيم كما هي في الداتا بيز تماماً -->
                    <div class="text-end">

                        <!-- عرض النقدية إذا وجدت في عمود AmntTrnsAct -->
                        @if (cashAmount > 0)
                        {
                            <small class="text-muted d-block">نقدية</small>
                            <h4 class="@textClass fw-bold mb-0" dir="ltr">@cashAmount.ToString("N0") @sign</h4>
                        }

                        <!-- عرض الرصيد إذا وجد في عمود BlncTrnsAct -->
                        @if (balanceAmount > 0)
                        {
                            <small class="text-muted d-block @(cashAmount > 0 ? "mt-2" : "")">رصيد</small>
                            <h4 class="@(isIncoming ? "text-success" : "text-primary") fw-bold mb-0" dir="ltr">@balanceAmount.ToString("N0") @sign</h4>
                        }

                        <!-- في حال كانت العملية صفرية -->
                        @if (cashAmount == 0 && balanceAmount == 0)
                        {
                            <small class="text-muted d-block">القيمة</small>
                            <h4 class="text-muted fw-bold mb-0">0</h4>
                        }
                    </div>
                </div>

                <!-- شريط الأرصدة (المديونية فقط) -->
                <div class="row text-center bg-light rounded-3 py-2 mx-0 mt-2 border">
                    <div class="col-6 border-end border-2 px-1">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">المديونية قبل</small>
                        <strong class="text-dark">@(debtBefore.ToString("N0"))</strong>
                    </div>
                    <div class="col-6 px-1">
                        <small class="text-primary d-block" style="font-size: 0.75rem;">المديونية بعد</small>
                        <strong class="text-primary">@(debtAfter.ToString("N0"))</strong>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(item.Description) && item.Description != "-")
                {
                    <div class="mt-2 text-muted small px-1">
                        <i class="fas fa-info-circle text-secondary me-1"></i> @item.Description
                    </div>
                }
            </div>
        </div>
    }
}